# Server only. Never use NEXT_PUBLIC_ for database credentials.
DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require&channel_binding=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require&channel_binding=require
APP_URL=https://cbf.amsonline.lk
SECURE_COOKIES=1
# Cloud photo processing; originals are removed only after approval.
OCR_ENGINE=tesseract
# Optional vision OCR. Set OCR_ENGINE=cloudflare after verifying model access.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3.8-27b
# Optional for a new, empty database. Existing workspace credentials are migrated.
# WORKSPACE_PASSWORD=
# CONNECTOR_KEY=

# Private Cloudflare R2 bucket. Object Read & Write token scoped only to this bucket.
R2_BUCKET=cbf-invoice-drafts
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Random server-only secret for scheduled photo cleanup.
CRON_SECRET=
# FOCUS_LOCAL=1 uses SQLite for LAN use. Sample mode sets it automatically.
# DATA_DIR=
